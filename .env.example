ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGIN=
SESSION_SECRET=
SITE_URL=

# Required for the advertiser-only nearby-business search (Google Places).
# Server-side only - never sent to the browser. See services/places.service.js.
GOOGLE_MAPS_API_KEY=

# Required for advertiser-only upload verification (content safety + OCR
# business-name extraction). See services/verification.service.js - these
# are currently unwired stub interfaces; verification.service.js documents
# exactly which function to implement once a provider is chosen.
AI_MODERATION_API_KEY=
OCR_API_KEY=

# Radius (in meters) for the nearby-business search. Matches the "~3 KM"
# default from the spec; override per deployment if needed.
NEARBY_BUSINESS_RADIUS_M=3000